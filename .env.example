# Optional. When set, the LLM touchpoints (intent parse, rule drafting, tagging,
# retrieval ranking) call Claude. When unset, deterministic fallbacks run and the
# app still works end-to-end. Money math is deterministic regardless.
ANTHROPIC_API_KEY=

# Optional. Points the app at a different case bundle (default: cases/santacruz).
# CASE=cases/santacruz

# Ledger HMAC key. REQUIRED on any shared deploy (KENNY_REQUIRE_AUTH=1 enforces it).
# Keep it in the platform's secret store, never on the data volume: the key living
# apart from the ledger file is what makes the audit chain unforgeable to anyone
# with disk access. Generate with: openssl rand -base64 32
# KENNY_LEDGER_KEY=
