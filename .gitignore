.venv/
__pycache__/
*.pyc
.env

# Runtime artifacts (regenerated by ingest / chat)
cases/*/ledger.jsonl
cases/*/catalog.json
cases/*/search_index.jsonl
cases/*/rules/rules_proposed.json
cases/*/snapshots/*.json

# Generated PDFs + sidecars (produced by scripts/make_reference_pdfs.py)
cases/*/sources/*.pdf
cases/*/sources/*.clauses.json

# OS + junk
.DS_Store
0
*.bak
cases/*/rules/*.bak

# EXCEPT the real Santa Cruz corpus: downloaded-and-OCR'd originals (not regenerable by
# any script) and their baked extraction (a ~4GB-RSS ingest no cloud builder can repeat).
# These ARE the case — they ship in git. The blanket excludes above are for synthetic,
# regenerable corpora only.
!cases/santacruz/sources/*.pdf
!cases/santacruz/catalog.json
!cases/santacruz/search_index.jsonl
