    },
    {
      "id": "art9_2",
      "kind": "selector",
      "priority": 20,
      "when": "holiday_weekday in subject_schedule_days",
      "compute": "effective_base * hours + 150",
      "human_readable": "Weekend-shift exception: flat $150, no 1.5x.",
      "flags": [
        {
          "when": "True",
          "message": "\u00a79.2 silent on straight-time base for hours worked; confirm.",
          "alternate": "150"
        }
      ],
      "citation": {
