  "rules": [
    {
      "id": "art9_1",
      "kind": "selector",
      "priority": 10,
      "when": "True",
      "compute": "effective_base * 2.5 * hours",
      "human_readable": "Base + 1.5x holiday premium (2.5x) for hours worked.",
      "citation": {
        "doc_id": "mou_article9",
        "clause": "9.1",
        "page": 1,
