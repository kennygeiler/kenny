      "id": "art12_2",
      "kind": "selector",
      "priority": 20,
      "human_readable": "Graveyard-shift officers get no 1.0x holdover premium; instead a flat $200 night-holdover stipend at straight time.",
      "when": "subject_shift == 'Graveyard'",
      "compute": "effective_base * hours + 200",
      "flags": [
        {
          "when": "True",
          "message": "\u00a712.2 is silent on whether straight-time base is still paid for held-over hours. Primary reading pays base + $200; alternate pays $200 flat. Requires HR analyst confirmation.",
          "alternate": "200"
        }
