{
  "doc_id": "poa_article12",
  "mou_version": "POA-2024",
  "note": "Bi-weekly pay period = 80 hours. \u00a712.3 is enforced structurally: the differential % (diff_premium) references only base pay; the FTO flat premium (fto_premium) is a separate additive term and is never multiplied by a percentage.",
  "rules": [
    {
      "id": "premium_defaults",
      "kind": "modifier",
      "priority": 100,
      "human_readable": "Baseline: no differential and no FTO premium unless a clause applies.",
      "when": "True",
      "set": {
        "diff_premium": "0",
        "fto_premium": "0"
      },
      "status": "ratified",
      "approver": "seed-authored",
      "approved_at": "2026-07-15T00:00:00Z"
    },
    {
      "id": "art12_1_graveyard",
      "kind": "modifier",
      "priority": 50,
      "human_readable": "\u00a712.1 Graveyard differential: 8% of BASE hourly rate for all 80 hours worked in the pay period. Applies to base only.",
      "when": "subject_shift == 'Graveyard'",
      "set": {
        "diff_premium": "subject_base_hourly * 0.08 * 80"
      },
