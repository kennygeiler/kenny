    {
      "id": "sandcity_poa_mou:bilingual_premium",
      "kind": "modifier",
      "role": "differential",
      "pay_basis": "hourly",
      "result_type": "currency",
      "topic": "bilingual",
      "when": "subject_bilingual == True",
      "set": {
        "effective_base": "effective_base * 1.05"
      },
      "human_readable": "Certified bilingual employees receive a 5% premium added to their base hourly rate, factored into the base rate before any shift differential or holiday multiplier (Section 3.3).",
      "citation": {
        "clause": "3.3",
        "page": 4,
        "doc_id": "sandcity_poa_mou",
        "bbox": [
