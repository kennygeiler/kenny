          263.43000000000006
        ]
      },
      "status": "ratified",
      "_scenario": "police holiday shift 2026-07-04 (side letter supersedes \u00a76.1, graveyard 6.5%)",
      "approver": "hr-analyst",
      "approved_at": "2026-07-17T18:54:28Z"
    },
    {
      "id": "sandcity_poa_mou:holiday_work_premium",
