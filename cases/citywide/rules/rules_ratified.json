      "kind": "selector",
      "role": "base",
      "pay_basis": "hourly",
      "result_type": "currency",
      "topic": "holiday",
      "when": "holiday_weekday != '' and not (holiday_weekday in ['Sat','Sun'] and subject_schedule_days != '' and holiday_weekday in subject_schedule_days)",
