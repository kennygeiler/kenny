      "role": "base",
      "pay_basis": "hourly",
      "result_type": "currency",
      "topic": "holiday",
      "when": "holiday_weekday != ''",
      "compute": "effective_base * 2.5 * hours",
      "human_readable": "Sworn personnel mandated to work a recognized City holiday receive 2.5x the base rate (base plus 1.5x premium) for all hours worked, applied after shift differential and bilingual premium are incorporated (Section 5.2).",
